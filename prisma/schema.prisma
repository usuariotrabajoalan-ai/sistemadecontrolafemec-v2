generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. SISTEMA DE EXTRAS AFEMEC (afemec-extras)
// -----------------------------------------------------

model ExtrasStaff {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("fullname")
  cedula    String   @unique
  createdAt String   @map("createdat")

  records   ExtrasWorkRecord[]

  @@map("staff")
}

model ExtrasTaskType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt String   @map("createdat")

  records   ExtrasWorkRecord[]

  @@map("task_types")
}

model ExtrasWorkRecord {
  id                 Int     @id @default(autoincrement())
  taskTypeId         Int     @map("tasktypeid")
  taskTypeName       String  @map("tasktypename")
  sector             String
  requestedBy        String  @map("requestedby")
  status             String  @default("PENDING")
  
  staffId            Int?    @map("staffid")
  staffName          String? @map("staffname")
  staffCedula        String? @map("staffcedula")
  description        String?
  photosBefore       String? @map("photosbefore")
  photosAfter        String? @map("photosafter")
  
  encargadoSignature String? @map("encargadosignature")
  orderNumber        Int?    @map("ordernumber")
  workerComments     String? @map("workercomments")
  
  createdAt          String  @map("createdat")
  monthKey           String  @map("monthkey")

  staff              ExtrasStaff?    @relation(fields: [staffId], references: [id])
  taskType           ExtrasTaskType  @relation(fields: [taskTypeId], references: [id])

  @@map("work_records")
}

model ExtrasAdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("admin")

  @@map("admin_users")
}

// -----------------------------------------------------
// 2. SISTEMA DE ASISTENCIAS MA"VIL (asistencia-app)
// -----------------------------------------------------

model AsistenciaEmployee {
  id        String   @id @default(cuid())
  ci        String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  attendances AsistenciaRecord[]
}

model AsistenciaRecord {
  id          String   @id @default(cuid())
  employeeId  String
  type        String   // "ENTRADA" o "SALIDA"
  timestamp   DateTime @default(now())
  latitude    Float?
  longitude   Float?
  photoBase64 String?  // Base64 o URL
  observation String?
  
  employee    AsistenciaEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AsistenciaConfig {
  id            String @id @default("main")
  adminPassword String @default("admin123")
}

// -----------------------------------------------------
// 3. PROYECTO COBERTURAS LIMPIEZA (sistema-limpieza)
// -----------------------------------------------------

model CoberturaUser {
  id        String   @id @default(cuid())
  name      String
  document  String   @unique // DNI/CI
  password  String
  role      String   @default("CLEANER") // "ADMIN" or "CLEANER"
  jobs      CoberturaJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoberturaLocation {
  id        String   @id @default(cuid())
  name      String 
  campus    String   @default("Sede Social") 
  jobs      CoberturaJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoberturaJob {
  id               String    @id @default(cuid())
  date             DateTime // Event Date
  startTime        String 
  scheduledEndTime String? 
  imageUrl         String? 
  status           String    @default("PENDING") 
  notes            String? 
  endTime          DateTime? 
  signatureUrl     String? 

  userId           String
  user             CoberturaUser   @relation(fields: [userId], references: [id])

  locationId       String
  location         CoberturaLocation @relation(fields: [locationId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}